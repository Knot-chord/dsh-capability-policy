    "dsh": ">=0.2.1-rc.5 <0.3.0-0",
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "capability",
    "dispatch",
    "automation",
    "ownership",
    "policy",
    "audit"
  ],
  "exports": {
